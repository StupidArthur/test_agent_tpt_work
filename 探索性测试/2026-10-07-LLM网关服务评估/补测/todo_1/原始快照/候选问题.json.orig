{
  "_note": "候选问题/差异，待双方审核。编号不复用、不撤回；结论强度不超过证据强度。",
  "task": "2026-10-07-LLM网关服务评估",
  "items": [
    {
      "id": "DIFF-01",
      "kind": "候选问题（计量）",
      "title": "隐藏推理计入 output_tokens，但 reasoning_tokens 报 0",
      "observed": "非流式与流式响应中，output 含 type=reasoning 的项（reasoning_text 有内容），而 usage.output_tokens_details.reasoning_tokens=0；output_tokens 明显包含这部分消耗（例：同时只问 OK 的轮次 output_tokens=15、reasoning 文本可见）。",
      "expected": "若网关把推理计入 output_tokens，宜在 reasoning_tokens 中体现；否则客户端无法区分可见输出与隐藏推理计量。",
      "impact": "性能/容量的 output token 吞吐口径会包含隐藏推理，需在报告中标注；不改变端到端延迟结论。",
      "evidence": ["证据/api/API-04_tpt-gateway-public_turn1__r2.json", "证据/api/API-09_tpt-gateway-public_usage.json"],
      "cases": ["API-09", "TPT-03", "TPT-06"],
      "status": "待审核"
    },
    {
      "id": "DIFF-02",
      "kind": "候选问题（目录语义）",
      "title": "三条模型均标 is_default=true",
      "observed": "GET /models 返回 flash、flash-backup-ds、pro，三条的 is_default 都为 true。",
      "expected": "默认模型标记通常唯一；多条 is_default 可能让适配器默认选择不确定。",
      "impact": "TPT 适配器按 is_default 对齐默认模型时结果可能不稳定；不构成请求失败。",
      "evidence": ["证据/api/API-01_tpt-gateway-public_models__r3.json"],
      "cases": ["API-01", "TPT-02"],
      "status": "待审核"
    },
    {
      "id": "DIFF-03",
      "kind": "候选问题（能力声明，未验证）",
      "title": "pro/flash-backup-ds 声明 image 输入，未验证 input_image 是否真可用",
      "observed": "目录中 pro、flash-backup-ds 的 modalities.input 含 image；本轮未发送含 input_image 的请求。",
      "expected": "声明支持则应能用 data URL 的 input_image 完成图片问答（TPT-05）。",
      "impact": "无法据此判断视觉能力；需按 TPT-05 在冻结样本下补测。",
      "evidence": ["证据/api/API-01_tpt-gateway-public_models__r3.json"],
      "cases": ["TPT-05"],
      "status": "未验证"
    },
    {
      "id": "DIFF-04",
      "kind": "执行器候选差异（已纠正）",
      "title": "Responses 历史 assistant 条目用 output_text 数组被 400 拒绝",
      "observed": "原 attempt 历史条目 assistant content=[{type:output_text}] 返回 400（240 validation errors）。改用字符串 content 后 200。",
      "expected": "契约资料描述 assistant → output_text 项；实际网关输入不接受该形态。",
      "impact": "属客户端请求形态问题；若宿主适配器也发该形态将失败，需以当前包实测核对（本轮未取得当前安装包）。",
      "evidence": ["证据/api/API-04_tpt-gateway-public_turn2.json", "证据/api/API-04_probe_summary.json"],
      "cases": ["API-04", "TPT-07"],
      "status": "执行器侧已纠正；宿主契约影响待核对"
    },
    {
      "id": "DIFF-05",
      "kind": "环境现象",
      "title": "curl 经代理返回 502，直连客户端返回 200",
      "observed": "curl.exe 访问 /models（带 key）得 502；执行器 http.client 直连同地址同 key 得 200。",
      "expected": "同一服务对同一请求不应因客户端/代理不同而一 502 一 200。",
      "impact": "影响探测通道选择；非网关缺陷证据。",
      "evidence": ["证据/api/API-01_tpt-gateway-public_models__r3.json"],
      "cases": ["API-01"],
      "status": "待审核（通道/代理）"
    },
    {
      "id": "DIFF-06",
      "kind": "观察（截断）",
      "title": "低输出上限时正文可完全缺失",
      "observed": "max_output_tokens=16/32 时，响应 status=incomplete，incomplete_details.reason=max_output_tokens，可见正文为空（预算被隐藏推理占满）。",
      "expected": "截断是合法行为；此处仅记录“正文可能为空”。",
      "impact": "客户端的短输出上限需预留隐藏推理预算，否则拿不到正文。",
      "evidence": ["证据/api/API-09_tpt-gateway-public_usage.json", "证据/tpt/TPT-08_tpt-gateway-public_lowlimit.json"],
    {
      "id": "DIFF-07",
      "kind": "候选问题（终态一致性）",
      "title": "达到输出上限时：非流式给 incomplete，流式给 completed",
      "observed": "非流式 API-09（max=32）status=incomplete / reason=max_output_tokens；流式 PERF-03（max=512）10/10 终态 completed，output_tokens 恰为 512；流式 TPT-08（max=16）亦 completed。",
      "expected": "截断是否完成宜在两种形态一致呈现，便于客户端识别未完整完成。",
      "impact": "流式客户端可能把被截断的回答当完整成功；影响截断判定与计量口径。",
      "evidence": ["证据/api/API-09_tpt-gateway-public_usage.json", "证据/perf/PERF-03_tpt-gateway-public.json", "证据/tpt/TPT-08_tpt-gateway-public_lowlimit.json"],
      "cases": ["API-09", "TPT-08", "PERF-03"],
      "status": "待审核"
    }
  ]
