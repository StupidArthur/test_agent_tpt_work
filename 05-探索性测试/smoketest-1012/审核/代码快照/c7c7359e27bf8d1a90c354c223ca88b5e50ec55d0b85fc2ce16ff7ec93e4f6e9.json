  "routes": [
    {
      "id": "application.connection",
      "module": "application",
      "title": "核对连接与当前详情身份",
      "intent": "观察",
      "guide": "已启动时核对连接；启动与安装定位走 TPT Work 接入技能。详情身份读取不能替代连接核验。",
      "functions": [
        "application.inspectConnection",
        "application.readDetailIdentity"
      ]
    },
    {
      "id": "conversation.session",
      "module": "conversation",
      "title": "新建、查找、进入会话",
      "intent": "查找/创建",
      "guide": "先按唯一身份查找，再进入指定会话；搜索计数不证明目标会话命中。",
      "functions": [
        "conversation.newTask",
        "conversation.openSession",
        "conversation.listSessionRows",
        "conversation.searchSessions",
        "conversation.openSearchShortcut"
      ]
    },
    {
      "id": "conversation.draft",
      "module": "conversation",
      "title": "准备、读取与清空草稿",
      "intent": "修改/观察",
      "guide": "准备当前输入和引用；发送与终态在执行场景，附件在附件模块。",
      "functions": [
        "conversation.readComposer",
        "conversation.clearDraft",
        "conversation.readComposerMenu",
        "conversation.clickAutomationCase"
      ]
    },
    {
      "id": "conversation.execution",
      "module": "conversation",
      "title": "发送消息、审批与读取终态",
      "intent": "执行/观察",
      "guide": "发送后绑定 session 与唯一回复判断终态；审批须遵循本轮授权。",
      "functions": [
        "conversation.sendMessage",
        "conversation.decideApproval",
        "conversation.readTaskState",
        "conversation.readCompletion"
      ]
    },
    {
      "id": "conversation.trace",
      "module": "conversation",
      "title": "检查工作步骤、工具轨迹与产物",
      "intent": "观察",
      "guide": "按业务断言选择轨迹、工具详情或真实产物；可见记录数量不能证明执行成功。",
      "functions": [
        "conversation.readToolTrace",
        "conversation.readToolDetail",
        "conversation.readArtifact",
        "conversation.readWorkSteps",
        "conversation.readVisibleToolCalls",
        "conversation.readTraceVisible"
      ]
    },
    {
      "id": "conversation.permission",
      "module": "conversation",
      "title": "读取或修改当前任务权限",
      "intent": "修改/观察",
      "guide": "仅当前任务；默认权限转设置模块。改前保留初值，改后回读并恢复。",
      "functions": [
        "conversation.readTaskPermissionOptions",
        "conversation.setTaskPermission"
      ]
    },
    {
      "id": "conversation.project",
      "module": "conversation",
      "title": "发现项目控件与已有选项",
      "intent": "查找",
      "guide": "只发现当前已有项目，不创建项目；先核对真实控件和选项身份。",
      "functions": [
        "conversation.readProjectControls",
        "conversation.readProjectOptions"
      ]
    },
    {
      "id": "conversation.sidebar",
      "module": "conversation",
      "title": "侧栏排序、未读与提醒",
      "intent": "修改/观察",
      "guide": "排序和未读只作用于指定会话或当前列表；排序修改需要恢复。",
      "functions": [
        "conversation.markUnread",
        "conversation.readUnreadBadge",
        "conversation.readSortMenu",
        "conversation.setSort"
      ]
    },
    {
      "id": "conversation.links",
      "module": "conversation",
      "title": "回复链接、侧面板与帮助入口",
      "intent": "执行/观察",
      "guide": "链接请求日志依赖本轮夹具；请求发生不能替代目标面板可见断言。",
      "functions": [
        "conversation.openLinkInReply",
        "conversation.readSidePanelVisible",
        "conversation.readLinkLog",
        "conversation.openHelpFeedback"
      ]
    },
    {
      "id": "conversation.dialogs",
      "module": "conversation",
      "title": "读取或关闭页面弹窗",
      "intent": "观察/恢复",
      "guide": "先看真实弹窗再有限关闭；不以关闭弹窗代替业务确认。",
      "functions": [
        "conversation.readDialogs",
        "conversation.closeDialogs"
      ]
    },
    {
      "id": "conversation.legacy-plugin",
      "module": "conversation",
      "title": "读取左侧插件页卡片",
      "intent": "观察",
      "guide": "旧左侧插件页面读法；设置中的内置插件用 settings.plugins。",
      "functions": [
        "conversation.readPluginCard"
