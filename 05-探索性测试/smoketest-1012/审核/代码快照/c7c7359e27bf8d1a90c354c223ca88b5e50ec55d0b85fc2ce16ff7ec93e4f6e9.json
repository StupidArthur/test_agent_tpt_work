    {
      "id": "conversation.usage",
      "module": "conversation",
      "title": "读取输入区用量展示",
      "intent": "观察",
      "guide": "仅用量文本与字段可见性，不推断计费或模型能力。",
      "functions": [
        "conversation.readUsageFooter"
      ]
    },
    {
      "id": "attachments.draft",
