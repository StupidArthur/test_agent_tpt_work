{
  "name": "@tpt-work/sandbox-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "TPT 沙箱 UI：设置页状态/安装/卸载 + 首次打开引导（dual-face client 插件）",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "package.json",
    "!**/*.d.ts",
    "!**/*.d.ts.map",
    "!**/*.js.map",
    "!**/*.tsbuildinfo"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2",
    "@tpt-work/danger-verbs": "0.0.0",
    "@tpt-work/sandbox": "0.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-client-locale": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-settings-general": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.1",
    "@deepseek-ai/dsh-settings": "0.2.0-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.1",
    "@types/react": "~18.3.31",
    "react": "18.3.1",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}