{
  "name": "@tpt-work/sandbox",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "TPT 受限执行后端两档：默认 ACL 档（直接复用 dsh windows-acl 库）；提权档以 codex-command-runner 帧 IPC + 沙箱用户接管 windows-acl 沙箱链",
  "main": "./lib/index.mjs",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.mjs"
    },
    "./runner": {
      "types": "./lib/runner.d.ts",
      "default": "./lib/runner.mjs"
    },
    "./acl-launcher": {
      "types": "./lib/acl-launcher.d.ts",
      "default": "./lib/acl-launcher.mjs"
    },
    "./setup-cli": {
      "types": "./lib/setup-cli.d.ts",
      "default": "./lib/setup-cli.mjs"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "scripts/bootstrap.mjs",
    "package.json",
    "!**/*.d.ts",
    "!**/*.d.ts.map",
    "!**/*.js.map",
    "!**/*.tsbuildinfo",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.spec.ts",
    "!src/**/*.spec.tsx"
  ],
  "dependencies": {
    "@deepseek-ai/dsh-sandbox-windows-acl": "0.2.0-rc.1",
    "@tpt-work/data-root": "0.1.3-alpha.1",
    "koffi": "^3.1.6"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-sandbox": "0.2.0-rc.1",
    "@deepseek-ai/dsh-sandbox-local": "0.2.0-rc.1",
    "@deepseek-ai/dsh-session": "0.2.0-rc.1",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}